# Виртуальное окружение
.venv/
venv/

# PyCharm / IDE
.idea/
*.iml

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Сборка EXE. PyInstaller пишет рабочие файлы в build/, поэтому исключаем всю
# папку, кроме скрипта сборки и спецификации.
build/*
!build/build.ps1
!build/*.spec
dist/

# Временные файлы Excel
~$*.xlsx

# Результаты работы пайплайна
output/reports/*.xlsx
data/generated/*
data/intermediate/run_stamp.txt

# Журнал падения приложения
crash.log